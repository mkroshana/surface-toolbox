<UserControl x:Class="SurfaceFanControl.UI.Views.BatteryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SurfaceFanControl.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BatteryViewModel}">

    <!-- Battery page: read-only charge, health and capacity figures from the Windows battery driver.
         Its DataContext is a BatteryViewModel, which only polls while this page is on screen. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Charge and health summary -->
            <RowDefinition Height="Auto" />
            <!-- 1. Capacity details -->
            <RowDefinition Height="Auto" />
            <!-- 2. Source note -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Charge and Health Summary -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Charge -->
                    <Border Grid.Column="0" Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource BatteryGeometry}" Fill="{StaticResource AccentGreen}" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Charge" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ChargePercentText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Health -->
                    <Border Grid.Column="1" Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Battery Health" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HealthText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding HealthDetailText}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Column="1" Rows="2" Columns="2" VerticalAlignment="Center">
                    <!-- Cycle Count -->
                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Cycle Count" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding CycleCountText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                            <TextBlock Text="Full Charge Cycles" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Power Flow -->
                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Power Flow" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding PowerFlowText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                                <TextBlock Text="Into or Out of the Battery" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Path Grid.Column="1" Data="{StaticResource BoltGeometry}" Fill="{StaticResource AccentOrange}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.8" />
                        </Grid>
                    </Border>

                    <!-- Time Estimate -->
                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding TimeCaption}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                            <TextBlock Text="At the Present Rate" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Voltage -->
                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Voltage" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding VoltageText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                            <TextBlock Text="Battery Terminal" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Capacity Details -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Capacity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text=" • " FontSize="12" Foreground="{StaticResource TextTertiary}" />
                    <TextBlock Text="{Binding LastUpdatedText}" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                </StackPanel>

                <UniformGrid Columns="2">
                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Remaining" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Energy stored right now" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Full Charge" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="What a full battery holds today" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FullChargeText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Design" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="What it held when new" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DesignText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Lost Since New" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Design minus full charge" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CapacityLostText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Temperature" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="From the battery driver" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chemistry" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Cell type" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ChemistryText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Source Note -->
        <TextBlock Grid.Row="2"
                   Text="Read-only. Figures come from the Windows battery driver every 5 seconds while this page is open. Health is full-charge capacity as a share of design capacity."
                   FontSize="11" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,0,4,0" />
    </Grid>
</UserControl>
