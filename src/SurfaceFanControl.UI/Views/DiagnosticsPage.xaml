<UserControl x:Class="SurfaceFanControl.UI.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SurfaceFanControl.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}">

    <!-- Diagnostics page: Windows' own power reports, created on request and opened in the default
         browser without administrator rights. Nothing on this page changes a setting. -->
    <StackPanel>
        <!-- Battery Report -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BatteryGeometry}" Fill="{StaticResource AccentGreen}" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Battery Report" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Windows' own report: capacity history, recent usage and battery life estimates." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BatteryStatus}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryActionButton}" Content="Create Battery Report" Command="{Binding CreateBatteryReportCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Sleep Study -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ReportGeometry}" Fill="{StaticResource AccentBlue}" Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Sleep Study" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Windows' report on each sleep session: how long it lasted, how much battery it used, and what kept the device busy." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SleepStatus}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryActionButton}" Content="Create Sleep Study" Command="{Binding CreateSleepStudyCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Windows Power Settings -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BoltGeometry}" Fill="{StaticResource AccentOrange}" Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Windows Power Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Screen and sleep time-outs, energy saver and battery usage by app, in the Windows Settings app." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Power Settings" Command="{Binding OpenPowerSettingsCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" Margin="4,2,4,0">
            <Run Text="Reports are saved in" />
            <Run Text="{Binding ReportsFolder, Mode=OneWay}" />
            <Run Text="and replaced each time. They open in your default browser without administrator rights." />
        </TextBlock>
    </StackPanel>
</UserControl>
