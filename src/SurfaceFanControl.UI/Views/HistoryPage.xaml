<UserControl x:Class="SurfaceFanControl.UI.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SurfaceFanControl.UI.ViewModels"
             xmlns:controls="clr-namespace:SurfaceFanControl.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">

    <!-- History page: peak temperature, fan speed and CPU load over the last 5, 15 or 60 minutes.
         Readings are kept in memory only, for as long as the app runs, up to one hour. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Window choice and export -->
            <RowDefinition Height="Auto" />
            <!-- 1-3. One chart each -->
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <!-- 4. Export result -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window Choice and Export -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SubCardBackground}" BorderBrush="{StaticResource SubCardBorder}" BorderThickness="1" CornerRadius="7" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadioButton}" GroupName="HistoryWindow" Content="5 Min" IsChecked="{Binding IsWindow5, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SegmentRadioButton}" GroupName="HistoryWindow" Content="15 Min" IsChecked="{Binding IsWindow15, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SegmentRadioButton}" GroupName="HistoryWindow" Content="60 Min" IsChecked="{Binding IsWindow60, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding CoverageText}" FontSize="12" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Export CSV" Command="{Binding ExportCsvCommand}"
                    ToolTip="Save every recorded reading (up to the last hour) as a CSV file" VerticalAlignment="Center" />
        </Grid>

        <!-- Peak Temperature -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ThermometerGeometry}" Fill="{StaticResource AccentBlue}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Peak Temperature" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TemperatureStats}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <controls:LineChart Grid.Row="1" Values="{Binding TemperatureValues}" Stroke="{StaticResource AccentBlue}"
                                    GridBrush="{StaticResource SubCardBorder}" LabelBrush="{StaticResource TextTertiary}"
                                    MinimumRange="4" ValueFormat="0.0" MinHeight="70" />
            </Grid>
        </Border>

        <!-- Fan Speed -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource TachometerGeometry}" Fill="{StaticResource AccentGreen}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Fan Speed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding FanStats}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <controls:LineChart Grid.Row="1" Values="{Binding FanValues}" Stroke="{StaticResource AccentGreen}"
                                    GridBrush="{StaticResource SubCardBorder}" LabelBrush="{StaticResource TextTertiary}"
                                    MinimumRange="500" ValueFormat="0" MinHeight="70" />
            </Grid>
        </Border>

        <!-- CPU Load -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CpuGeometry}" Fill="{StaticResource AccentOrange}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="CPU Load" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CpuStats}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <controls:LineChart Grid.Row="1" Values="{Binding CpuValues}" Stroke="{StaticResource AccentOrange}"
                                    GridBrush="{StaticResource SubCardBorder}" LabelBrush="{StaticResource TextTertiary}"
                                    MinimumRange="20" ValueFormat="0" MinHeight="70" />
            </Grid>
        </Border>

        <!-- Export Result -->
        <TextBlock Grid.Row="4" Text="{Binding ExportStatus}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="4,0,4,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
