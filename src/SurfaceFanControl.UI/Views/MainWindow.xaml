<Window x:Class="SurfaceFanControl.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SurfaceFanControl.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Surface Fan Control"
        Height="760" Width="840"
        MinHeight="720" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Hero Telemetry -->
            <RowDefinition Height="Auto" />
            <!-- Profiles Section -->
            <RowDefinition Height="Auto" />
            <!-- Manual RPM Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- Stock Reset Bar -->
            <RowDefinition Height="Auto" />
            <!-- Detailed Sensors List -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Surface Fan Control" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,2" Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" />
                        </Border>
                        <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HardwareModeBadgeText}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceName}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Minimize to Tray" Click="OnMinimizeToTrayClick" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Hero Telemetry Dashboard -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Main Temp & Fan Gauge -->
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Primary Temp + Fan RPM -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Peak Temperature" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Text="{Binding CurrentPeakTempFormatted}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding PowerSourceText}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Fan Tachometer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Text="{Binding CurrentFanRpmFormatted}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FanStateSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Secondary Hardware Metrics -->
                <UniformGrid Grid.Column="1" Columns="4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!-- Average Temp -->
                    <Border Background="#1C1C20" CornerRadius="8" Padding="12,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Average Temp" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding CurrentAvgTempFormatted}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                            <TextBlock Text="Active Sensors" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Power Limits -->
                    <Border Background="#1C1C20" CornerRadius="8" Padding="12,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Power Limits" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding PowerLimitsFormatted}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                            <TextBlock Text="SMF PL1 / PL2" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- CPU Freq -->
                    <Border Background="#1C1C20" CornerRadius="8" Padding="12,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="CPU Clock" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding CpuFrequencyFormatted}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                            <TextBlock Text="Core Frequency" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- CPU Load -->
                    <Border Background="#1C1C20" CornerRadius="8" Padding="12,10" Margin="4">
                        <StackPanel>
                            <TextBlock Text="CPU Load" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding CpuPerformanceFormatted}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                            <TextBlock Text="Utilization" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 3. Profile Selection Cards -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Cooling Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />

            <UniformGrid Columns="3">
                <!-- Quiet Profile -->
                <Button Style="{StaticResource ProfileCardButton}" Command="{Binding SelectQuietCommand}" Margin="0,0,6,0" Height="96" Padding="14">
                    <StackPanel Width="220">
                        <TextBlock Text="Quiet / Silent" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="13W–20W PL1 / 28W PL2 efficiency mode with passive cooling priority." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <!-- Balanced Profile -->
                <Button Style="{StaticResource ProfileCardButton}" Command="{Binding SelectBalancedCommand}" Margin="3,0,3,0" Height="96" Padding="14">
                    <StackPanel Width="220">
                        <TextBlock Text="Balanced" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Surface factory default thermal curve and automatic SAM fan control." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Button>

                <!-- Turbo Profile -->
                <Button Style="{StaticResource ProfileCardButton}" Command="{Binding SelectTurboCommand}" Margin="6,0,0,0" Height="96" Padding="14">
                    <StackPanel Width="220">
                        <TextBlock Text="Turbo Cooling (4200 RPM)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="26W PL1 / 35W PL2 performance mode + direct 4200 RPM SAM spin-up." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- 4. Direct Manual Fan Speed Bar -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Manual Fan Speed Override" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Direct SAM command (0–4800 RPM)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="4800"
                        TickFrequency="200"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ManualSliderRpm, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Margin="12,0,12,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding ManualSliderRpmFormatted}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlue}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0" />

                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButton}"
                        Content="Apply RPM"
                        Command="{Binding ApplyManualRpmCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 5. Stock Reset Action Bar -->
        <Border Grid.Row="4" Background="#232328" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Stock OEM Settings Baseline" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Restore Surface power overlays, processor limits, and automatic SAM fan curve back to factory defaults." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Content="Reset to Stock Defaults"
                        Command="{Binding RestoreStockCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 6. Surface Thermal Sensors Detail List -->
        <Border Grid.Row="5" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Surface Hardware Sensors" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text=" • Live SAM &amp; ACPI Telemetry" FontSize="12" Foreground="{StaticResource AccentBlue}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1C20" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource TextTertiary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTemperature}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 7. Footer -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Surface Pro 9 • Windows 11" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
