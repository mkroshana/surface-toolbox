<Window x:Class="SurfaceToolbox.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SurfaceToolbox.UI.ViewModels"
        xmlns:views="clr-namespace:SurfaceToolbox.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Surface Toolbox"
        Icon="pack://application:,,,/SurfaceToolbox.UI;component/Assets/app.ico"
        Height="820" Width="1100"
        MinHeight="780" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Variable">

    <Grid Margin="24,14,24,14">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Sidebar and the selected page -->
            <RowDefinition Height="*" />
            <!-- 2. Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Modern Vector Fan Icon in Header -->
                        <Path Data="{StaticResource FanGeometry}" Fill="{StaticResource AccentBluePrimary}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Surface Toolbox" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" />
                        </Border>
                        <Border Background="#26262D" BorderBrush="#3F3F4C" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HardwareModeBadgeText}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceName}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="34,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Minimize to Tray" Click="OnMinimizeToTrayClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Sidebar navigation on the left, the selected page on the right.
             Each page is a UserControl; add a TabItem here to add a page. -->
        <TabControl Grid.Row="1" Style="{StaticResource SidebarTabControl}" TabStripPlacement="Left">
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Thermal &amp; Power" Tag="{StaticResource ThermometerGeometry}">
                <views:ThermalPowerPage />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Battery" Tag="{StaticResource BatteryGeometry}">
                <views:BatteryPage DataContext="{Binding Battery}" />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Display" Tag="{StaticResource DisplayGeometry}">
                <views:DisplayPage DataContext="{Binding Display}" />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="History" Tag="{StaticResource HistoryGeometry}">
                <views:HistoryPage DataContext="{Binding History}" />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Device" Tag="{StaticResource DeviceGeometry}">
                <views:DevicePage DataContext="{Binding Device}" />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Diagnostics" Tag="{StaticResource ReportGeometry}">
                <views:DiagnosticsPage DataContext="{Binding Diagnostics}" />
            </TabItem>
            <TabItem Style="{StaticResource SidebarTabItem}" Header="Settings" Tag="{StaticResource SettingsGeometry}">
                <views:SettingsPage DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- 2. Footer with Status and Clean Developer Links -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <!-- Right: Links and Device Info -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- GitHub Link -->
                <Button Style="{StaticResource SubtleLinkButton}" Command="{Binding OpenGitHubCommand}" ToolTip="https://github.com/mkroshana" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitHubGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="GitHub" FontSize="11" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Email Link -->
                <Button Style="{StaticResource SubtleLinkButton}" Command="{Binding OpenEmailCommand}" ToolTip="mailto:mkroshana@gmail.com" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource MailGeometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="mkroshana@gmail.com" FontSize="11" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="12" Fill="{StaticResource CardBorder}" Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- Machine Info -->
                <TextBlock Text="{Binding ProcessorName}" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
