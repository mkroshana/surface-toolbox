<UserControl x:Class="SurfaceToolbox.UI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SurfaceToolbox.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <!-- Settings page: how the app itself behaves. -->
    <StackPanel>
        <!-- Start With Windows -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start With Windows" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Starts in the tray when you sign in, with no administrator prompt. This adds a task named &quot;SurfaceToolbox Autostart&quot; to Windows Task Scheduler; turning it off removes the task."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StartupStatus}" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          AutomationProperties.Name="Start With Windows" VerticalAlignment="Center" Margin="16,0,2,0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
